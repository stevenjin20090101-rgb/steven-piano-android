<!-- Debug builds only: plain HTTP to the emulator's view of the Mac (10.0.2.2) and nowhere else,
     for the updater's test server (UpdateOverride). Release builds have no such file: cleartext is
     refused everywhere, as Android does by default. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
