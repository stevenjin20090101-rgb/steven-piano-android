<!-- The web panel's stroke glyph g-chevron (1.7 at a 24 box, round caps and joins): a row that opens a page: the chevron, pointing at the row's end. Tinted where it is used. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M 9.5,6 l 6,6 l -6,6"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
