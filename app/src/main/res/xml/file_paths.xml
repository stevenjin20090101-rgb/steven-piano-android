<!-- The only files the app ever shares, each with a one-off read grant: a downloaded update for
     Android's installer (cacheDir/updates/) and the diagnostics zip for the share sheet
     (cacheDir/diagnostics/). The library, the pieces, artwork and settings are never reachable. -->
<paths>
    <cache-path
        name="updates"
        path="updates/" />
    <cache-path
        name="diagnostics"
        path="diagnostics/" />
</paths>
