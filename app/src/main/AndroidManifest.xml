<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth LE MIDI to the piano. API 31+: scan never derives location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- API 26-30: legacy Bluetooth permissions, and scanning needs fine location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Artwork and notes from Wikipedia: two hosts only (en.wikipedia.org, upload.wikimedia.org),
         asked for page titles and searches made from the library's own names; nothing about the
         person is sent. Updates (v1.4): the release manifest from raw.githubusercontent.com and the
         file from github.com's release downloads (objects / release-assets.githubusercontent.com).
         Offline, nothing is fetched. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Updates (v1.4): a downloaded release goes to Android's installer, which asks the person to
         confirm (or, on the school tablet where the app is the device owner, installs it without a
         tap). Android installs only a file signed with the release key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Playback with the screen off, and imports that outlive the screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The web panel (v1.5.1): a local control panel is none of Android's named foreground types, so
         special use (its reason is the service's property below); connected device only as the fallback
         a device that refuses special use gets. Connected device is also the piano's firmware update's
         type (v1.6). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Schedules (v1.6.2): the piano plays by itself at set times, so the app keeps one exact alarm
         (timer play is what exact alarms exist for). Android 13 and newer grant USE_EXACT_ALARM with the
         app; Android 12 asks for SCHEDULE_EXACT_ALARM, which the person may take away (the Schedule page
         then asks for it back). A restart of the tablet clears the alarm: the app sets it again. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <!-- v1.11 — M29: MIDI keyboards and MIDI pianos through Android's MIDI service, by Bluetooth or by a USB cable
         (the tablet as USB host). Neither is required: without them the app plays Steven Piano as before. -->
    <uses-feature
        android:name="android.software.midi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- No backup, and (Android 12+) no device-to-device transfer: the library stays on this device. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StevenPiano"
        tools:targetApi="s">

        <!-- Authorship, also compiled into the app as Provenance.TAG (see PROVENANCE.md). -->
        <meta-data
            android:name="dev.stevenjin.stevenpiano.provenance"
            android:value="STEVEN-PIANO-PROVENANCE Made by Steven Jin &lt;stevenjin20090101@gmail.com&gt; Ed25519 fp eab16a502f679465" />

        <!-- Rotation and window resizes reach the activity as configuration changes instead of
             recreating it, so keys held on the Keys screen keep sounding (see MainActivity.onStop). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" for MIDI files that arrive with a MIDI type. Content URIs only: a file://
                 path from another app could point at this app's own files, a FIFO or /proc.
                 Whatever arrives waits for the person's Add (MainActivity's ShareSheet). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="audio/midi" />
                <data android:mimeType="audio/mid" />
                <data android:mimeType="audio/x-midi" />
                <data android:mimeType="application/x-midi" />
            </intent-filter>

            <!-- "Open with" for .mid / .midi files that arrive untyped. PatternMatcher's
                 ".*" stops at the first dot, hence the dotted variants. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mid" />
                <data android:pathPattern=".*\\..*\\.mid" />
                <data android:pathPattern=".*\\..*\\..*\\.mid" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.mid" />
                <data android:pathPattern=".*\\.midi" />
                <data android:pathPattern=".*\\..*\\.midi" />
                <data android:pathPattern=".*\\..*\\..*\\.midi" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.midi" />
                <data android:pathPattern=".*\\.MID" />
                <data android:pathPattern=".*\\..*\\.MID" />
                <data android:pathPattern=".*\\..*\\..*\\.MID" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.MID" />
            </intent-filter>

            <!-- Share sheet: one or many MIDI files. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/midi" />
                <data android:mimeType="audio/mid" />
                <data android:mimeType="audio/x-midi" />
                <data android:mimeType="application/x-midi" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Kiosk mode (Piano › Kiosk, v1.6.1): the app as the tablet's home screen, so Home and a restart land in it.
             Off as installed; only kiosk mode turns it on, and only while the app is the device owner, which also makes
             Home prefer it (admin/Kiosk.kt). Exported, as any home screen: Android starts it for Home. -->
        <activity-alias
            android:name=".KioskHome"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Playback with the screen off: the media notification, session and wake lock. -->
        <service
            android:name=".service.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Imports that outlive the screen, with a progress notification. -->
        <service
            android:name=".service.ImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Composers' portraits and notes fetched in the background, with a progress notification. -->
        <service
            android:name=".service.ArtworkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- A new release's download, with a progress notification and Cancel. -->
        <service
            android:name=".service.UpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Steven's library (v1.10 — M27): the pack's download from the release `library` and its import,
             with a progress notification and Cancel. -->
        <service
            android:name=".service.LibraryService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The web panel's server (Piano › Remote control › Web control): it listens on the tablet's tailnet
             address (the panel) and its Wi-Fi address (guests only, unless Panel on Wi-Fi too), never on all
             addresses, only while the switch is on and a PIN is set. Not exported: only the app starts it.
             v1.10 — M26: with remote access over the internet on (and the PIN set) it also keeps the tablet's
             one outbound connection to the owner's relay (Steven Piano Cloud), Web control on or not. -->
        <service
            android:name=".service.WebService"
            android:exported="false"
            android:foregroundServiceType="specialUse|connectedDevice"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Web control panel for the piano: on the person's own network, and through the owner's own relay" />
        </service>

        <!-- The piano's firmware update over Bluetooth (v1.6): about two minutes of transfer that outlive the
             screen and the app in the background, with a progress notification and Cancel. Connected device:
             the app talks to the piano throughout. Not exported: only the Firmware page starts it. -->
        <service
            android:name=".service.FirmwareService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Studio (v1.7): a model's download and a recording's transcription, one at a time, with a progress
             notification and Cancel, so they outlive the screen. Data sync: the jobs move data (a model in, a
             recording through the model into a piece). Not exported: only the app starts it. -->
        <service
            android:name=".service.StudioService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The schedules' alarm, and what makes it be set again: a restart, the clock or the time zone changed,
             the app updated, exact alarms allowed. Not exported: only the system and the app's own immutable
             PendingIntent (the alarm) reach it. -->
        <receiver
            android:name=".schedule.ScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Where a silent install (device owner) reports; only the app's own explicit PendingIntent reaches it. -->
        <receiver
            android:name=".update.UpdateResultReceiver"
            android:exported="false" />

        <!-- The school tablet's device owner, for silent updates and kiosk mode: no policies (res/xml/device_admin.xml).
             Exported for the system, which alone holds BIND_DEVICE_ADMIN. -->
        <receiver
            android:name=".admin.PianoDeviceAdmin"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Shares two cache folders and nothing else, one read grant at a time: a downloaded update
             with Android's installer, the diagnostics zip with the share sheet (res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
