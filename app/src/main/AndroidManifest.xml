<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth LE MIDI to the piano. API 31+: scan never derives location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- API 26-30: legacy Bluetooth permissions, and scanning needs fine location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Artwork and notes from Wikipedia: two hosts only (en.wikipedia.org, upload.wikimedia.org),
         asked for page titles and searches made from the library's own names; nothing about the
         person is sent. Updates (v1.4): the release manifest from raw.githubusercontent.com and the
         file from github.com's release downloads (objects / release-assets.githubusercontent.com).
         Offline, nothing is fetched. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Updates (v1.4): a downloaded release goes to Android's installer, which asks the person to
         confirm (or, on the school tablet where the app is the device owner, installs it without a
         tap). Android installs only a file signed with the release key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Playback with the screen off, and imports that outlive the screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The web panel (v1.5.1): a local control panel is none of Android's named foreground types, so
         special use (its reason is the service's property below); connected device only as the fallback
         a device that refuses special use gets. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- No backup, and (Android 12+) no device-to-device transfer: the library stays on this device. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StevenPiano"
        tools:targetApi="s">

        <!-- Authorship, also compiled into the app as Provenance.TAG (see PROVENANCE.md). -->
        <meta-data
            android:name="dev.stevenjin.stevenpiano.provenance"
            android:value="STEVEN-PIANO-PROVENANCE Made by Steven Jin &lt;stevenjin20090101@gmail.com&gt; Ed25519 fp eab16a502f679465" />

        <!-- Rotation and window resizes reach the activity as configuration changes instead of
             recreating it, so keys held on the Keys screen keep sounding (see MainActivity.onStop). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" for MIDI files that arrive with a MIDI type. Content URIs only: a file://
                 path from another app could point at this app's own files, a FIFO or /proc.
                 Whatever arrives waits for the person's Add (MainActivity's ShareSheet). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="audio/midi" />
                <data android:mimeType="audio/mid" />
                <data android:mimeType="audio/x-midi" />
                <data android:mimeType="application/x-midi" />
            </intent-filter>

            <!-- "Open with" for .mid / .midi files that arrive untyped. PatternMatcher's
                 ".*" stops at the first dot, hence the dotted variants. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mid" />
                <data android:pathPattern=".*\\..*\\.mid" />
                <data android:pathPattern=".*\\..*\\..*\\.mid" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.mid" />
                <data android:pathPattern=".*\\.midi" />
                <data android:pathPattern=".*\\..*\\.midi" />
                <data android:pathPattern=".*\\..*\\..*\\.midi" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.midi" />
                <data android:pathPattern=".*\\.MID" />
                <data android:pathPattern=".*\\..*\\.MID" />
                <data android:pathPattern=".*\\..*\\..*\\.MID" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.MID" />
            </intent-filter>

            <!-- Share sheet: one or many MIDI files. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/midi" />
                <data android:mimeType="audio/mid" />
                <data android:mimeType="audio/x-midi" />
                <data android:mimeType="application/x-midi" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Playback with the screen off: the media notification, session and wake lock. -->
        <service
            android:name=".service.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Imports that outlive the screen, with a progress notification. -->
        <service
            android:name=".service.ImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Composers' portraits and notes fetched in the background, with a progress notification. -->
        <service
            android:name=".service.ArtworkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- A new release's download, with a progress notification and Cancel. -->
        <service
            android:name=".service.UpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The web panel's server (Piano › Remote control › Web control): it listens on the tablet's tailnet
             address (the panel) and its Wi-Fi address (guests only, unless Panel on Wi-Fi too), never on all
             addresses, only while the switch is on and a PIN is set. Not exported: only the app starts it. -->
        <service
            android:name=".service.WebService"
            android:exported="false"
            android:foregroundServiceType="specialUse|connectedDevice"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local web control panel for the piano, on the person's own network" />
        </service>

        <!-- Where a silent install (device owner) reports; only the app's own explicit PendingIntent reaches it. -->
        <receiver
            android:name=".update.UpdateResultReceiver"
            android:exported="false" />

        <!-- The school tablet's device owner, for silent updates only: no policies (res/xml/device_admin.xml).
             Exported for the system, which alone holds BIND_DEVICE_ADMIN. -->
        <receiver
            android:name=".admin.PianoDeviceAdmin"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Shares two cache folders and nothing else, one read grant at a time: a downloaded update
             with Android's installer, the diagnostics zip with the share sheet (res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
