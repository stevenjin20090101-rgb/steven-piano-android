// M79: Fessenden's short address, https://playerpiano-stevenjin.<you>.workers.dev. Every request goes on (302) to
// that piano's panel on the relay: / opens the panel, /request the guest page. No bindings. Until PIANO_ID is set it
// answers 503 "This piano isn't set up yet." Deploy with `npm run deploy:short` once the tablet is enrolled (README.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "playerpiano-stevenjin",
  "main": "src/short/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,

  "vars": {
    // The relay's address, as in wrangler.console.jsonc.
    "RELAY_URL": "https://steven-piano-relay.sjengineering.workers.dev",
    // The piano's id (12 letters, from the console) once its tablet is enrolled. Empty: 503.
    "PIANO_ID": ""
  }
}
