//
// The console: the owner's Worker, behind Cloudflare Access (enabled on its workers.dev route in the
// dashboard), which also checks every request's Cf-Access-Jwt-Assertion itself. It reaches each
// piano's PianoRoom in the relay through the ROOMS binding, and shares the relay's D1.
// Deploy with `npm run deploy:console`, after the relay (README.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "steven-piano-console",
  "main": "src/console/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,

  // The page, its script and its stylesheet. Every request runs the Worker first, which checks Access.
  "assets": {
    "directory": "./console/static",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "PianoRoom", "script_name": "steven-piano-relay" }]
  },

  // The same database as the relay: paste the same id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "steven-piano",
      "database_id": "9f271e87-90f7-445a-a8b2-7cfa1deeff3a",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Your Zero Trust team name: the <team> in https://<team>.cloudflareaccess.com.
    "ACCESS_TEAM_DOMAIN": "proud-lab-b14d",
    // The relay's address, as `npm run deploy:relay` printed it.
    "RELAY_URL": "https://steven-piano-relay.sjengineering.workers.dev"
  },
  // The secret ACCESS_AUD (the Access application's audience tag): `npx wrangler secret put ACCESS_AUD -c wrangler.console.jsonc`.

  "dev": { "ip": "127.0.0.1", "port": 8788 }
}
