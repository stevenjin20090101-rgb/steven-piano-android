//
// The relay: the public Worker. Tablets connect to /tablet; browsers reach a piano's panel at
// /p/<pianoId>/…; a tablet enrols at POST /api/enrol. One PianoRoom Durable Object per piano.
// Deploy with `npm run deploy:relay` (README.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "steven-piano-relay",
  "main": "src/relay/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,

  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "PianoRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PianoRoom"] }],

  // `npx wrangler d1 create steven-piano` prints the id: paste it here and in wrangler.console.jsonc.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "steven-piano",
      "database_id": "9f271e87-90f7-445a-a8b2-7cfa1deeff3a",
      "migrations_dir": "migrations"
    }
  ],

  // Per client address, per Cloudflare location (the binding is a brake, not an exact count).
  "ratelimits": [
    { "name": "ENROL_LIMIT", "namespace_id": "7301", "simple": { "limit": 5, "period": 60 } },
    { "name": "PANEL_LIMIT", "namespace_id": "7302", "simple": { "limit": 120, "period": 60 } },
    { "name": "LOGIN_LIMIT", "namespace_id": "7303", "simple": { "limit": 10, "period": 60 } }
  ],

  "vars": {
    // The Free plan's request body limit: 100 MB.
    "MAX_BODY_BYTES": 104857600,
    // The host browsers use for the relay, when it isn't the one the tablet connected to
    // (`npm run dev` sets localhost:8787 while the emulator connects to 10.0.2.2:8787). Empty: the tablet's.
    "PUBLIC_HOST": ""
  },

  // Every day at 03:17 UTC: the audit log's rows older than 90 days go, and codes and pianos never used.
  "triggers": { "crons": ["17 3 * * *"] },

  "dev": { "ip": "127.0.0.1", "port": 8787 }
}
